import { defineConfig } from 'vitepress'

const repoUrl = 'https://github.com/springledev/avapeek'

/**
 * Pages generated by scripts/sync-docs.mjs, mapped to their source file in the
 * repository. Everything else under docs/ is copied from the repo's docs/;
 * the remaining pages live in website/src/.
 */
const generatedSources: Record<string, string> = {
  'docs/index.md': 'website/docs-index.md',
  'security-policy.md': 'SECURITY.md',
  'changelog.md': 'CHANGELOG.md',
}

function repoSourcePath(relativePath: string): string {
  if (relativePath in generatedSources) {
    return generatedSources[relativePath]
  }

  return relativePath.startsWith('docs/') ? relativePath : `website/src/${relativePath}`
}

export default defineConfig({
  title: 'Avapeek',
  description: 'End-to-end encrypted, self-hosted family photo sharing.',
  lang: 'en',
  srcDir: 'src',
  base: '/',
  cleanUrls: true,
  lastUpdated: false,
  ignoreDeadLinks: 'localhostLinks',
  sitemap: { hostname: 'https://avapeek.com/' },

  // Runs at build time. editLink.pattern must stay a string: a function would be
  // rebuilt in the browser with new Function(), which the site's CSP blocks.
  transformPageData(pageData) {
    pageData.filePath = repoSourcePath(pageData.relativePath)
  },

  head: [
    ['link', { rel: 'icon', type: 'image/svg+xml', href: '/favicon.svg' }],
    ['meta', { name: 'theme-color', content: '#faf6f1' }],
    ['meta', { property: 'og:type', content: 'website' }],
    ['meta', { property: 'og:site_name', content: 'Avapeek' }],
    ['meta', { property: 'og:image', content: 'https://avapeek.com/icon-192.png' }],
  ],

  markdown: {
    theme: { light: 'github-light', dark: 'github-dark' },
    languageAlias: { env: 'dotenv' },
    defaultHighlightLang: 'text',
  },

  themeConfig: {
    logo: { src: '/favicon.svg', alt: '' },

    nav: [
      { text: 'Install', link: '/docs/installation' },
      { text: 'Docs', link: '/docs/', activeMatch: '^/docs/' },
      { text: 'Security', link: '/docs/security' },
      { text: 'FAQ', link: '/docs/faq' },
      { text: 'Changelog', link: '/changelog' },
    ],

    sidebar: [
      {
        text: 'About',
        items: [
          { text: 'Overview', link: '/' },
          { text: 'Why Avapeek?', link: '/docs/why-avapeek' },
          { text: 'Hosted version', link: '/hosted' },
          { text: 'Roadmap and known issues', link: '/docs/roadmap' },
          { text: 'Changelog', link: '/changelog' },
        ],
      },
      {
        text: 'Self-hosting',
        items: [
          { text: 'Installation', link: '/docs/installation' },
          { text: 'Configuration', link: '/docs/configuration' },
          { text: 'Storage', link: '/docs/storage' },
          { text: 'FAQ and troubleshooting', link: '/docs/faq' },
        ],
      },
      {
        text: 'Security',
        items: [
          { text: 'Security model', link: '/docs/security' },
          { text: 'Reporting a vulnerability', link: '/security-policy' },
        ],
      },
      {
        text: 'Internals',
        items: [
          { text: 'Architecture', link: '/docs/architecture' },
          { text: 'Development', link: '/docs/development' },
        ],
      },
    ],

    socialLinks: [{ icon: 'github', link: repoUrl }],

    editLink: {
      // :path is the repository path set in transformPageData above.
      pattern: `${repoUrl}/blob/master/:path`,
      text: 'View source on GitHub',
    },

    search: { provider: 'local' },
    outline: { level: [2, 3], label: 'On this page' },

    footer: {
      message: 'Released under the AGPL-3.0-or-later license.',
      copyright: '<a href="https://springle.dev/">springle.dev</a>',
    },
  },
})
