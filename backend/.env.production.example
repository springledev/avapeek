# ============================================================
# Avapeek — Production Environment
# Copy to backend/.env.production and fill in your values.
# ============================================================

APP_NAME=Avapeek
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://your-domain.com
# Origin the web app is served from (usually identical to APP_URL). Required in
# production: passkeys (WebAuthn) bind to it and CORS allows it.
FRONTEND_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcasting / Queue / Cache ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Email (core doesn't send email; cloud fork overrides) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="avapeek@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object Storage (any S3-compatible provider) ---
# Defaults below are for the bundled self-hosted Garage
# (COMPOSE_PROFILES=garage in the root .env). For AWS S3, Backblaze B2,
# Cloudflare R2 etc. see docs/storage.md, then verify with:
#   docker compose exec backend php artisan storage:check
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY must match S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY in the root .env when using Garage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=photos
AWS_ENDPOINT=http://garage:3900
AWS_USE_PATH_STYLE_ENDPOINT=true
# Garage only: rewrites presigned URLs to the app origin (Caddy proxies
# /photos/* to Garage). Leave unset/empty for external providers.
AWS_TEMPORARY_URL="${APP_URL}"

# --- Storage quota (optional) ---
# Hard limit in bytes. With no limit and no volume path the limit is
# "unknown" and uploads are not capped by the app (typical for external S3).
# STORAGE_LIMIT_BYTES=10737418240   # 10 GB
# Self-hosted Garage: derive the limit from 90 % of free space at this path.
# With the garage profile, keep this (compose mounts garage_data there).
# For external S3 providers, remove it: the limit is then unknown.
STORAGE_VOLUME_PATH=/garage-data
