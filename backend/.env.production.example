# ============================================================
# Avapeek — Production Environment
# Copy to backend/.env.production and fill in your values.
# ============================================================

APP_NAME=Avapeek
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcasting / Queue / Cache ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Email (core doesn't send email; cloud fork overrides) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="avapeek@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object Storage (Garage — self-hosted S3-compatible) ---
# These must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# from your root .env file.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=photos
AWS_ENDPOINT=http://garage:3900
AWS_URL="${APP_URL}"
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Dynamic Storage Quota ---
# Point this to the host path where the garage_data volume lives.
# The quota is calculated as 90 % of free disk space at this path.
# Self-hosters who use external S3 can leave this unset — the
# quota will be unlimited.
# Docker example: /var/lib/docker/volumes/avapeek_garage_data
STORAGE_VOLUME_PATH=

# --- Fixed Storage Limit (optional) ---
# Uncomment to override the dynamic quota with a hard limit.
# STORAGE_LIMIT_BYTES=10737418240   # 10 GB
