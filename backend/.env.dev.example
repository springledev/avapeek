# ============================================================
# Avapeek — Development Environment
# Copy to backend/.env and fill in your values.
# ============================================================

APP_NAME=Avapeek
APP_ENV=local
APP_KEY=base64:YOUR_GENERATED_KEY
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (PostgreSQL) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=secret

# --- Session ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Broadcasting / Queue / Cache ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=secret
REDIS_PORT=6379

# --- Email (Mailpit catches everything in dev) ---
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="avapeek@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# --- Object Storage (Garage by default; see docs/storage.md for external S3) ---
# These must match S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from the root .env
AWS_ACCESS_KEY_ID=GKa1b2c3d4e5f60718293a4b5c
AWS_SECRET_ACCESS_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
AWS_DEFAULT_REGION=garage
AWS_BUCKET=photos
AWS_ENDPOINT=http://127.0.0.1:3900
AWS_USE_PATH_STYLE_ENDPOINT=true
# Only for the local-proxy setup; leave unset for external providers.
AWS_TEMPORARY_URL=http://localhost:8000

# --- Dynamic Storage Quota (dev) ---
# Compose mounts garage_data at /garage-data in the backend container.
# Remove for external S3 providers (limit becomes unknown).
STORAGE_VOLUME_PATH=/garage-data

VITE_APP_NAME="${APP_NAME}"
