# ============================================================
# Avapeek — Development Docker Compose Environment
# Copy to .env and fill in your values.
# These variables are interpolated by docker compose at startup.
# ============================================================

# --- PostgreSQL ---
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=secret

# --- Redis ---
# Must match REDIS_PASSWORD in backend/.env (dev)
REDIS_PASSWORD=secret

# --- Storage profile ---
# Self-hosted Garage is opt-in. Uncomment to start garage + garage-init.
# Leave unset when using an external S3 provider (AWS, B2, R2, ...).
# Requires Docker Compose >= 2.20. See docs/storage.md.
# COMPOSE_PROFILES=garage

# --- Garage (self-hosted S3, only used with COMPOSE_PROFILES=garage) ---
# GARAGE_RPC_SECRET: 32-byte hex secret.   Generate: openssl rand -hex 32
# S3_ACCESS_KEY_ID: "GK" + 24 hex chars.   Generate: echo "GK$(openssl rand -hex 12)"
# S3_SECRET_ACCESS_KEY: 64 hex chars.      Generate: openssl rand -hex 32
# The S3_* values are imported into Garage by garage-init and MUST match
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in backend/.env.
GARAGE_RPC_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
S3_ACCESS_KEY_ID=GKa1b2c3d4e5f60718293a4b5c
S3_SECRET_ACCESS_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100
# Optional: admin API token (defaults to GARAGE_RPC_SECRET). openssl rand -base64 32
GARAGE_ADMIN_TOKEN=
