# ============================================================
# Avapeek — Production Docker Compose Environment
# Copy to .env and fill in your values.
# These variables are interpolated by docker compose at startup.
# ============================================================

# --- PostgreSQL ---
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=change-me-please

# --- Redis ---
# Must match REDIS_PASSWORD in backend/.env
REDIS_PASSWORD=change-me-please

# --- Storage profile ---
# Self-hosted Garage is opt-in. Uncomment to start garage + garage-init.
# Leave unset when using an external S3 provider (AWS, B2, R2, ...).
# Requires Docker Compose >= 2.20. See docs/storage.md.
# COMPOSE_PROFILES=garage

# --- Garage (self-hosted S3, only used with COMPOSE_PROFILES=garage) ---
# GARAGE_RPC_SECRET: 32-byte hex secret.   Generate: openssl rand -hex 32
# S3_ACCESS_KEY_ID: "GK" + 24 hex chars.   Generate: echo "GK$(openssl rand -hex 12)"
# S3_SECRET_ACCESS_KEY: 64 hex chars.      Generate: openssl rand -hex 32
# The S3_* values are imported into Garage by garage-init and MUST match
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in backend/.env.
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Admin API token. Generate: openssl rand -base64 32
# If left empty, falls back to GARAGE_RPC_SECRET.
GARAGE_ADMIN_TOKEN=

# --- Client IP (only if a proxy or tunnel sits in front of Caddy) ---
# Off by default: forwarding headers are ignored and rate limits use the address
# connecting to Caddy. Behind a proxy, every client shares that proxy's limits until
# you list its address here, space-separated. Read docs/configuration.md#client-ip
# first: an address listed here can claim to be any client.
# UPSTREAM_TRUSTED_PROXIES=172.18.0.1
# Header holding the client address. Cloudflare Tunnel: CF-Connecting-IP.
# UPSTREAM_CLIENT_IP_HEADER=X-Forwarded-For

# --- Release ---
# Image tag pulled from ghcr.io/springledev/avapeek-* by ./up.sh (default: latest).
# Ignored when building from source (./up.sh --build).
# AVAPEEK_VERSION=latest
