# ============================================================
# Avapeek — Production Docker Compose Environment
# Copy to .env and fill in your values.
# These variables are interpolated by docker compose at startup.
# ============================================================

# --- PostgreSQL ---
DB_DATABASE=avapeek
DB_USERNAME=avapeek
DB_PASSWORD=change-me-please

# --- Redis ---
# Must match REDIS_PASSWORD in backend/.env
REDIS_PASSWORD=change-me-please

# --- MinIO ---
# Must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in
# backend/.env
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-please
