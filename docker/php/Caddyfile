{
	frankenphp
	order php_server before file_server
}

:80 {
	root * /app/public
	encode zstd br gzip

	php_server

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Deny hidden files
	@hidden path */.*
	respond @hidden 404
}
