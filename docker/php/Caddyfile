{
	frankenphp
	order php_server before file_server
}

:80 {
	root * /app/public
	encode zstd br gzip

	# Proxy Garage bucket requests — used for presigned URLs.
	# Override the Host header so Garage's signature validation matches.
	handle /photos/* {
		reverse_proxy garage:3900 {
			header_up Host garage:3900
		}
	}

	php_server

	# Security headers (duplicated by reverse proxy in production;
	# needed when FrankenPHP is exposed directly, e.g. in dev)
	# No Content-Security-Policy here: this server returns JSON and ciphertext, and
	# in dev Laravel's debug error page needs inline script/style. The production
	# Caddy (docker/caddy/Caddyfile) sets the CSP for everything it serves.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "0"
		Referrer-Policy "no-referrer"
	}

	# Deny hidden files
	@hidden path */.*
	respond @hidden 404
}
