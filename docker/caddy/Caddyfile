:80 {
    # API routes -> FrankenPHP/Laravel backend
    handle /api/* {
        reverse_proxy backend:80 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # NOTE: if a Content-Security-Policy with connect-src/img-src is ever added,
    # it must include the object storage origin (the browser fetches presigned
    # URLs directly from the provider when using AWS S3 / B2 / R2).

    # Proxy Garage bucket requests — used for presigned URLs.
    # Override the Host header so Garage's signature validation matches.
    # Only used with the self-hosted Garage profile; with an external S3
    # provider this route is never hit (Caddy resolves the upstream lazily).
    handle /photos/* {
        reverse_proxy garage:3900 {
            header_up Host garage:3900
        }
    }

    # All other routes -> Vue SPA frontend
    handle {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Proto {scheme}
        }
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    encode zstd gzip
}
